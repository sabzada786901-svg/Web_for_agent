# ===================================================================
# AgenticAim Backend Environment Configuration
# ===================================================================

# Server Port
PORT=3000

# Recipient email address where contact submissions are sent
CONTACT_EMAIL_TO=sabzada786901@gmail.com

# ===================================================================
# SMTP Mail Provider Configuration
# ===================================================================
# For Gmail:
#   1. Go to Google Account -> Security -> 2-Step Verification (turn ON)
#   2. Go to "App passwords" (https://myaccount.google.com/apppasswords)
#   3. Create an app password for "AgenticAim"
#   4. Use your full gmail address for SMTP_USER and the 16-character app password for SMTP_PASS
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
#
# Alternatively, for SendGrid, Brevo, Mailgun, or AWS SES:
# SMTP_HOST=smtp.sendgrid.net (or smtp-relay.brevo.com)
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey (or Brevo login)
# SMTP_PASS=your_api_key_or_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AgenticAim Contact" <noreply@agenticaim.com>

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGIN=*

# Rate Limiter Window (in minutes) and Max requests per window per IP
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

